# Copy to .env.local (gitignored) and fill in to enable the live-LLM E2E test.
#
# Deliberately NOT prefixed with VITE_: Vite only exposes VITE_* variables to the
# client bundle, so naming it this way keeps the key out of the built extension.
# It is read on the Node side by the Playwright config and written straight into
# chrome.storage.local at test time.
#
# Without these, e2e/live-llm.spec.ts skips and the rest of the suite is unaffected.

DEEPSEEK_API_KEY=
# Optional overrides:
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
